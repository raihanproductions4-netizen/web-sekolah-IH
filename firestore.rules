rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "raihanproductions4@gmail.com"
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin');
    }

    function isBendahara() {
      return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'bendahara');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection - Read and write allowed for institution staff and initial seeding
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Students Collection - Accessible for school operations
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if true;
      allow write: if true;
    }

    // Bills (Tagihan SPP) Collection
    match /bills/{billId} {
      allow read: if true;
      allow write: if true;
    }

    // Payments (Transaksi Pembayaran) Collection
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    // School Settings Collection
    match /school_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
